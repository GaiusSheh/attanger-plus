prefs-maintenance = Copy maintenance
prefs-maintain =
    .label = Keep the copies in the collection folders up to date
prefs-maintain-hint = Off, the plugin only checks, locates files and repairs on request; it no longer copies, deletes or moves files as you work in Zotero. Turning it back on scans at once; what changed meanwhile can be repaired from the check report.
prefs-dry-run =
    .label = Dry run (log only, leave files alone)
prefs-dry-run-hint = On, copy maintenance and repairs only write what they would do to the operation log; changes in Zotero (removal from a collection, moving to the trash) still take effect.
prefs-notify =
    .label = Notify in the corner when something was done
prefs-inspect =
    .label = At startup, look for changes made in the file manager and show them
prefs-files = Files root
prefs-root = Zotero’s base directory for linked files: { $root } (change it in Zotero’s Settings → Advanced → Files and Folders)
prefs-root-unset = Zotero’s base directory for linked files is not set (Settings → Advanced → Files and Folders); copy maintenance cannot work.
prefs-log = Operation log
prefs-log-path = Every write is logged here, one file per month: { $folder }
prefs-open-log =
    .label = Open This Month’s Log
