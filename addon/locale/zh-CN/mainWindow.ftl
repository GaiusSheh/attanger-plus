startup-loaded = { $name } { $version } 已加载
menu-check =
    .label = Attanger Plus：检查文库…
menu-reveal =
    .label = 在文件资源管理器中显示（当前 collection）
reveal-missing-copy = 「{ $collection }」的文件夹里没有「{ $file }」的副本。
reveal-missing-file = 文件不存在：{ $file }
reveal-restore-prompt = 其中 { $count } 个可以从这个文件的其他副本恢复。
reveal-restore-button = 从其他副本恢复
reveal-restore-dry-run = 试运行模式：没有真的恢复，要执行的操作已记入操作日志。
reveal-restore-failed = 没能恢复「{ $file }」，原因见操作日志。
changes-dry-run = 试运行模式：文件操作（恢复、同步、重新定位）没有真的执行，已记入操作日志；Zotero 里的改动（移出 collection、移进回收站、忽略）照常生效。
changes-done = 已完成：恢复 { $restored } 份副本，从 collection 移除 { $removed } 次，同步 { $synced } 份副本，重新定位 { $relocated } 个文件，移进回收站 { $trashed } 项，忽略 { $ignored } 条。
changes-failed = 有 { $count } 项没能完成，原因见操作日志。
# Shown after the unfiled window has closed, so it lives here (src/ui/unfiled.ts).
unfiled-done = 加回 collection：{ $cancelled } 个条目；移进回收站：{ $trashedItems } 个条目；删除文件：{ $trashedFiles } 个条目；彻底删除：{ $erasedItems } 个条目；保留条目和文件（放到根目录）：{ $kept } 个条目。
unfiled-dry-run = 试运行开着：Zotero 里的改动已经生效，文件只记了日志，没有挪动。
menu-remove-current =
    .label = 从当前 collection 移除
menu-remove-all =
    .label = 从所有 collection 移除
menu-remove-chosen =
    .label = 从指定 collection 移除…
remove-confirm-current = 把 { $count } 个条目从「{ $collection }」中移除？它们在这个文件夹里的副本会被删除；只在这一个 collection 中的条目，接下来会询问怎么处理它们的文件。
remove-confirm-all = 把 { $count } 个条目从它们所在的所有 collection 中移除？移除后它们不在任何 collection 中，接下来会询问怎么处理它们的文件。
# 副本维护做完后的右下角提示（src/ui/toast.ts）。
toast-headline = Attanger Plus
toast-headline-dry-run = Attanger Plus（试运行，未实际执行）
toast-line = { $title }：{ $actions }
toast-separator = ，
toast-item-copied = 复制到 { $count } 个文件夹
toast-item-deleted = 删除 { $count } 份副本
toast-item-renamed = 改名 { $count } 份
toast-item-trashed = { $count } 个文件移进插件回收站
toast-item-restored = { $count } 个文件从插件回收站放回
toast-item-purged = 插件回收站里的文件已删除
toast-collection-moved = 文件夹从 { $from } 挪来
toast-collection-files-moved = 挪入 { $count } 个文件
toast-collection-trashed = 文件夹移进插件回收站
toast-collection-restored = 文件夹从插件回收站放回
toast-collection-purged = 文件夹已从插件回收站删除
toast-gone = { $count } 个已彻底删除的条目：插件回收站里的文件已删除
toast-more = ……另外 { $count } 项
toast-problems = { $count } 项未完成，详见检查报告
