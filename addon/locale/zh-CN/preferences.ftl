prefs-maintenance = 副本维护
prefs-maintain =
    .label = 自动维护各 collection 文件夹里的副本
prefs-maintain-hint = 关掉后插件只保留检查、定位和一键修复，不再跟着 Zotero 里的操作复制、删除、挪动文件。重新打开时会立即扫描一次；关闭期间的变化在检查报告里可以一键修复。
prefs-dry-run =
    .label = 试运行（只记日志，不动文件）
prefs-dry-run-hint = 打开时副本维护和修复只把要做的操作写进操作日志；Zotero 里的改动（移出 collection、移进回收站）照常生效。
prefs-notify =
    .label = 操作做完在右下角提示
prefs-inspect =
    .label = 启动时检查文件管理器里的变化，有就弹出汇总窗口
prefs-files = 文件根目录
prefs-root = Zotero 的链接附件根目录：{ $root }（在 Zotero「设置 → 高级 → 文件和文件夹」里修改）
prefs-root-unset = Zotero 的链接附件根目录未设置（「设置 → 高级 → 文件和文件夹」），副本维护无法工作。
prefs-log = 操作日志
prefs-log-path = 每个写操作都记在这里，一个月一个文件：{ $folder }
prefs-open-log =
    .label = 打开本月操作日志
