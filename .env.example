# Copy to .env (not committed). `npm start` refuses to run unless both the
# profile and the data directory are set and differ from the real ~/Zotero.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=C:/Program Files/Zotero/zotero.exe
ZOTERO_PLUGIN_PROFILE_PATH=C:/Users/<you>/Zotero-dev/profile
ZOTERO_PLUGIN_DATA_DIR=C:/Users/<you>/Zotero-dev/data
